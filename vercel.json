{
  "redirects": [
    {
      "source": "/register",
      "destination": "/signup",
      "permanent": true
    },
    {
      "source": "/register/",
      "destination": "/signup",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/product",
      "permanent": true
    },
    {
      "source": "/platform",
      "destination": "/product",
      "permanent": true
    },
    {
      "source": "/team/:path*",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/case-studies/:path*",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/resources/:path*",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/product",
      "destination": "/product.html"
    },
    {
      "source": "/industries/healthcare",
      "destination": "/industries/healthcare.html"
    },
    {
      "source": "/industries/technology",
      "destination": "/industries/technology.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/accessibility",
      "destination": "/accessibility.html"
    },
    {
      "source": "/(blog|careers|start|contact|developers|login|signup|client|onboarding|dashboard|pipeline|roles|outreach|agents|candidates|settings|calls|tasks|shortlists|crm|admin|og)(/.*)?",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(dashboard|crm|candidates|roles|settings|pipeline|calls|outreach|agents|onboarding|admin|client|tasks|shortlists|login|signup|developers|og)(/.*)?",
      "headers": [
        {
          "key": "x-robots-tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "x-robots-tag",
          "value": "index, follow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(about|blog|blog/.*)",
      "headers": [
        {
          "key": "x-robots-tag",
          "value": "index, follow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://*.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src 'none'; object-src 'none'; base-uri 'self';"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ]
}
