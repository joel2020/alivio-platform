# =============================================================================
# ALIVIO PLATFORM - ENVIRONMENT VARIABLE REFERENCE
# Copy this file to .env and fill in your values.
# Never commit the .env file (it is in .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: local dev override for Node backend URL used in Agents page.
VITE_LOCAL_BACKEND_URL=http://localhost:8787

# -----------------------------------------------------------------------------
# Supabase Edge Functions (shared runtime auth + data access)
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Dedicated scheduler secret for cron/webhook invocations.
SCHEDULER_SECRET=

# -----------------------------------------------------------------------------
# AI providers (Supabase edge + local helpers)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

OLLAMA_URL=
OLLAMA_MODEL=gemma3:4b
OLLAMA_AUTH=

# OpenAI-compatible override for backend/alivio-backend and local scripts
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Google / Vertex (Supabase edge + backend/alivio-backend)
# -----------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
GOOGLE_PROJECT_ID=alivio-475419
GOOGLE_LOCATION=us
GOOGLE_ENGINE_ID=
GOOGLE_SERVING_CONFIG=default_search
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
VERTEX_SEARCH_ENDPOINT=
VERTEX_SEARCH_SERVING_CONFIG=
VERTEX_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Email ingestion + outbound notifications
# -----------------------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true

RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
NOTIFICATION_FROM_EMAIL=noreply@aliviosearchpartners.com
APP_BASE_URL=https://aliviosearchpartners.com

# -----------------------------------------------------------------------------
# Node backend runtime (backend/src and backend/alivio-backend)
# -----------------------------------------------------------------------------
PORT=8787
NODE_ENV=development
APP_MODE=mock
DEBUG_LOGS=false
SERVICE_NAME=alivio-search-partners-backend
ENABLE_CORS=true
CORS_ORIGIN=
WEBHOOK_SECRET=
MAX_REQUEST_BYTES=1mb
REQUEST_ID_HEADER=x-request-id

# Optional script/runtime helper base URL
ALIVIO_API_BASE_URL=http://localhost:8080
