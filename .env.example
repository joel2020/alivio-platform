# =============================================================================
# ALIVIO PLATFORM - ENVIRONMENT VARIABLE REFERENCE
# Copy this file to .env and fill in your values.
# Never commit the .env file (it is in .gitignore).
# Owner notes: see ENV-MATRIX.md for full ownership mapping.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (Vite) - Required for the React app to talk to Supabase
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Supabase Edge Functions - Required for all backend edge functions
# Owner: devops
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SCHEDULER_SECRET: A dedicated secret used by your cron/scheduler to invoke
# service-only edge functions (fetch-emails, email-pipeline, auto-followup, etc.).
# Generate with: openssl rand -hex 32
# Set this in both your scheduler config AND your Supabase edge function secrets.
# Preferred over passing SUPABASE_SERVICE_ROLE_KEY directly to schedulers.
# Owner: devops
SCHEDULER_SECRET=

# -----------------------------------------------------------------------------
# AI Provider - OpenRouter (primary), Ollama (local fallback)
# Owner: backend
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

OLLAMA_URL=
OLLAMA_MODEL=gemma3:4b
OLLAMA_AUTH=

# OpenAI-compatible LLM (optional override)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Email Ingestion (IMAP) - Required for inbound email pipeline
# Owner: ops/backend
# -----------------------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true

# -----------------------------------------------------------------------------
# Email Outbound (Resend) - Required for candidate outreach and notifications
# Owner: ops/backend
# -----------------------------------------------------------------------------
RESEND_API_KEY=
SCHEDULER_SECRET=
ADMIN_NOTIFICATION_EMAIL=
NOTIFICATION_FROM_EMAIL=

# The email address used as the From: header in all outbound emails.
# Must be a verified sender domain in Resend.
# Owner: ops
NOTIFICATION_FROM_EMAIL=noreply@aliviosearchpartners.com

# Where admin notifications (e.g. new client inquiries) are sent.
# Set to your team inbox or personal email.
# Owner: ops/product
ADMIN_NOTIFICATION_EMAIL=

# Base URL for links in notification emails (e.g. CRM links)
APP_BASE_URL=https://aliviosearchpartners.com

# -----------------------------------------------------------------------------
# Alivio Agent Backend (Node.js server in backend/alivio-backend)
# Owner: backend
# -----------------------------------------------------------------------------
PORT=8787
APP_MODE=mock
DEBUG_LOGS=false

# -----------------------------------------------------------------------------
# Vertex AI Search / Discovery Engine (live mode only)
# Owner: backend/devops
# -----------------------------------------------------------------------------
GOOGLE_PROJECT_ID=alivio-475419
GOOGLE_LOCATION=us
GOOGLE_ENGINE_ID=
GOOGLE_SERVING_CONFIG=default_search
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
