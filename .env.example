# =============================================================================
# ALIVIO PLATFORM - ENVIRONMENT VARIABLE REFERENCE
# Copy this file to .env and fill in your values.
# Never commit the .env file (it is in .gitignore).
#
# AI PROVIDER POLICY: Azure OpenAI is the ONLY LLM provider for this platform.
# Do NOT add OpenRouter, Ollama, Anthropic, or direct OpenAI keys.
# All AI calls route through Supabase Edge Functions → _shared/azure.ts
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: local dev override for Node backend URL used in Agents page.
VITE_LOCAL_BACKEND_URL=http://localhost:8787

# -----------------------------------------------------------------------------
# Supabase Edge Functions (shared runtime auth + data access)
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Dedicated scheduler secret for cron/webhook invocations.
SCHEDULER_SECRET=

# -----------------------------------------------------------------------------
# Azure OpenAI — SOLE AI PROVIDER
# All Edge Functions call _shared/azure.ts which reads these variables.
# Set these in Supabase Vault for Edge Functions.
# Set the VITE_ prefixed ones below only if a client-visible config is needed.
# -----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_PRIMARY_DEPLOYMENT=gpt-4o
AZURE_OPENAI_FALLBACK_DEPLOYMENT=gpt-35-turbo

# -----------------------------------------------------------------------------
# Email ingestion + outbound notifications
# -----------------------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true

RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
NOTIFICATION_FROM_EMAIL=noreply@aliviosearchpartners.com
APP_BASE_URL=https://aliviosearchpartners.com

# -----------------------------------------------------------------------------
# Google Search (Vertex Search / Custom Search — NOT Vertex AI/LLM)
# Used only for candidate sourcing search queries, not for LLM completions.
# -----------------------------------------------------------------------------
GOOGLE_ENGINE_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=us
GOOGLE_SERVING_CONFIG=default_search
VERTEX_SEARCH_ENDPOINT=
VERTEX_SEARCH_SERVING_CONFIG=
VERTEX_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Node backend runtime (backend/src and backend/alivio-backend)
# -----------------------------------------------------------------------------
PORT=8787
NODE_ENV=development
APP_MODE=mock
DEBUG_LOGS=false
SERVICE_NAME=alivio-search-partners-backend
ENABLE_CORS=true
CORS_ORIGIN=
WEBHOOK_SECRET=
MAX_REQUEST_BYTES=1mb
REQUEST_ID_HEADER=x-request-id
ALIVIO_API_BASE_URL=http://localhost:8080
